# Servidor
PORT=3333
NODE_ENV=development
# Chave de assinatura dos tokens JWT (troque em producao)
JWT_SECRET=troque-esta-chave-em-producao
# Caminho do banco SQLite
DATABASE_FILE=./data/rhmacaw.db
# Diretorio onde os arquivos de remessa bancaria sao gravados
EXPORT_DIR=./data/exports
# Usuario administrador criado no seed
SEED_ADMIN_EMAIL=admin@rhmacaw.com.br
SEED_ADMIN_PASSWORD=Macaw@2025
