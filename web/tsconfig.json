{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./.tsbuild",
    "noEmit": false,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../packages/shared"
    }
  ],
  "exclude": [
    "src/demo/**"
  ]
}
